{
  "name": "pump-scanner-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that scans crypto markets for momentum/volume pump signals and sends buy alerts.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "scan:once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ccxt": "^4.4.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
