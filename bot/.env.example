# --- Telegram ---
# Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric chat id (message @userinfobot to get it). Alerts are sent here.
TELEGRAM_CHAT_ID=

# --- Market ---
# Any ccxt exchange id (binance, bybit, okx, kucoin, mexc, gateio, ...).
EXCHANGE=binance
QUOTE_CURRENCY=USDT
# "spot" or "swap" (linear USDT perpetual FUTURES). swap = where most pumps/dumps happen.
MARKET_TYPE=spot
# Which signals to send: "pump" (buy/long), "dump" (sell/short), or "both".
SIGNAL_DIRECTION=pump

# Seconds between scan cycles (lower = faster alerts, more API calls).
SCAN_INTERVAL_SEC=20
# Symbols deep-scanned per cycle as a ROTATING batch — covers ALL coins over time.
MAX_DEEP_SCAN=120
# Top 24h movers always scanned every cycle (so fast pumps are never missed).
MOVERS_PER_SCAN=25
# Confirm live order-book buy pressure before alerting (true/false). Off = faster, more signals.
CHECK_ORDER_BOOK=false
# Max alerts sent per scan cycle (strongest first) so a hot market doesn't flood you.
MAX_ALERTS_PER_CYCLE=8
# Minutes between "still alive" heartbeat messages so quiet periods don't look dead. 0 = off.
HEARTBEAT_MINUTES=60
# Paper-trade each signal for this many minutes to measure how it played out.
TRACK_HORIZON_MINUTES=60
# Win rule: favourable % target a signal must hit to count as a win in /winrate.
WIN_THRESHOLD_PCT=5
# Win rule: adverse % stop — if hit before the target, the trade is a loss.
TRACK_STOP_PCT=5
# Log signals to console instead of sending to Telegram (for testing).
DRY_RUN=false

# --- Pump detection thresholds (also tunable at runtime via /set) ---
# Minimum candle history guard (kept for safety; detection is multi-window).
WINDOW_MINUTES=3
# Minimum % price gain over the best window (checked across 1/2/3/5/10/15/30m).
MIN_WINDOW_CHANGE_PCT=2
# Volume over the winning window must be >= this multiple of the prior window.
MIN_VOLUME_SURGE=1.5
# Liquidity floor (24h quote volume). Lower = more (riskier) small-cap signals.
MIN_QUOTE_VOLUME=100000
# Skip alerts whose scam/risk score exceeds this (0 clean .. 100 likely trap).
MAX_RISK_SCORE=80
# Reject if RSI(14) is above this (already overbought / likely late).
MAX_RSI=92
# Minimum composite score (0-100) required to alert.
MIN_SCORE=22
# Per-symbol alert cooldown, minutes (anti-spam).
COOLDOWN_MINUTES=10
